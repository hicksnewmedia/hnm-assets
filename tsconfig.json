{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "esModuleInterop": true, "strict": true,
    "skipLibCheck": true, "noUnusedLocals": true, "resolveJsonModule": true,
    "isolatedModules": true, "types": ["node"],
    "lib": ["DOM", "DOM.Iterable", "ES2020"]
  },
  "include": ["src", "studio", "vite.config.ts"]
}
